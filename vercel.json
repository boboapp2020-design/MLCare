{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "headers": [
    { "source": "/",              "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/index.html",    "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/sw.js",         "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/app.js",        "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/config.js",     "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/data.js",       "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/styles.css",    "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/manifest.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/ICon.png",      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/home.png",      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/icon-192.png",  "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/icon-512.png",  "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
